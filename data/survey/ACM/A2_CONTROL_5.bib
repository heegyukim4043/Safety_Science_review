@inproceedings{10.1145/3656766.3656823,
author = {Chen, Mingming},
title = {Algorithmic-control analysis of improvisational behavior of gig workers based on PSL-SEM method},
year = {2024},
isbn = {9798400716478},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
url = {https://doi.org/10.1145/3656766.3656823},
doi = {10.1145/3656766.3656823},
abstract = {Algorithmic control, as a digital labor management practice in the gig economy, is key to testing the effectiveness of platform technology and management strategies in a nearly human-free human-machine interaction process to inspire improvisational behaviors of gig workers. In light of this, this study adopts PSL-SEM method to investigate the impact mechanism of perceived algorithmic control on gig workers' improvisational behaviors. The questionnaire survey reveals that the three dimensions of perceived algorithmic control have differentiated impact effects on gig workers: (1) algorithmic normative guidance promotes work involvement, thereby increasing their improvisational behaviors; (2) algorithmic tracking and evaluation triggers emotional exhaustion, leading to a decrease in their improvisational behaviors; (3) algorithmic behavioral constraints also induce emotional exhaustion, resulting in a decrease in their improvisational behaviors.},
booktitle = {Proceedings of the 2023 3rd International Conference on Big Data, Artificial Intelligence and Risk Management},
pages = {328–336},
numpages = {9},
location = {Chengdu, China},
series = {ICBAR '23}
}

