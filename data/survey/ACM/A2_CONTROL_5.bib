@inproceedings{10.1145/3500868.3559452,
author = {Gonzalez-Jimenez, Shreepriya and Boulard, Cecile and Tuco, Clara and Calleau, Romane},
title = {Designing Food Delivery Gig-platforms for Courier Needs: the Case of Batched Orders},
year = {2022},
isbn = {9781450391900},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
url = {https://doi.org/10.1145/3500868.3559452},
doi = {10.1145/3500868.3559452},
abstract = {The food delivery gig-platforms such as Uber Eats and Deliveroo increasingly batch orders, i.e., couriers deliver multiple orders in one trip to optimize order delivery. Prior studies investigate the topic of batching orders from a theoretical perspective, i.e., optimization, without taking contextual elements and worker preferences into account. In our paper, we elaborate on the couriers’ perspectives and needs in batched order delivery based on a qualitative study. We identify several criteria used by couriers to accept and reject the batched orders. We propose an alternative order batching solution that supports courier needs.},
booktitle = {Companion Publication of the 2022 Conference on Computer Supported Cooperative Work and Social Computing},
pages = {163–167},
numpages = {5},
location = {Virtual Event, Taiwan},
series = {CSCW'22 Companion}
}

