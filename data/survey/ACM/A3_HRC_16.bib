author = {Dimitrov, Velin and Cebry, Nicholas and {\"O}nal, {\c C}a{\u g}das and Pad{\i}r, Ta{\c s}k{\i}n},
title = {Towards user-centered design of a robotic prosthetic hand with EMG control interfaces},
