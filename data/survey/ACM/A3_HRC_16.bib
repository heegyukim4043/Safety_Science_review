@inproceedings{10.1145/3624323.3624330,
author = {Berdal, Quentin and Michel, Emelyne and Richard, Philippe and Paglia, Christopher},
title = {Operating a remote autonomous train: degradation of senses and cooperation},
year = {2024},
isbn = {9798400709104},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
url = {https://doi.org/10.1145/3624323.3624330},
doi = {10.1145/3624323.3624330},
abstract = {Alors que plusieurs lignes de m{\'e}tro fonctionnent d{\'e}j{\`a} de fa{\c c}on autonome et que les essais de v{\'e}hicules routiers autonomis{\'e}s sont fortement m{\'e}diatis{\'e}s, le service ferroviaire extra-urbain entame {\'e}galement une transition vers l’autonomie du mat{\'e}riel roulant. {\`A} l’{\'e}quilibre entre le contr{\^o}le presque complet de l’environnement des m{\'e}tros et celui presque inexistant du monde automobile, le r{\'e}seau ferroviaire pourrait atteindre un fonctionnement autonome avant les v{\'e}hicules routiers. Cependant, de fortes contraintes de s{\'e}curit{\'e} s’appliquent et n{\'e}cessitent encore l’intervention de l’humain. Cette situation requiert l’{\'e}tablissement d’une coop{\'e}ration avec le syst{\`e}me autonome, qui devient d’autant plus compliqu{\'e}e qu’il est envisag{\'e} de t{\'e}l{\'e}op{\'e}rer le v{\'e}hicule en cas de reprise n{\'e}cessaire. Les besoins de coop{\'e}ration avec le syst{\`e}me autonome seront d{\'e}taill{\'e}s dans ce papier, ainsi que l’implication des pertes sensorielles li{\'e}es {\`a} la t{\'e}l{\'e}op{\'e}ration. L’approche du projet Train L{\'e}ger innovant dans ce cadre sera pr{\'e}sent{\'e}e ainsi que les {\'e}l{\'e}ments retenus {\`a} l’heure.},
booktitle = {Proceedings of the 18th "Ergonomie et Informatique Avanc{\'e}e" Conference},
articleno = {7},
numpages = {9},
keywords = {contr{\^o}le partag{\'e}, coop{\'e}ration, syst{\`e}mes autonomes, t{\'e}l{\'e}op{\'e}ration},
location = {Bidart, France},
series = {Ergo'IA '23}
}

