@inproceedings{10.1145/3409120.3410659,
author = {Wintersberger, Philipp and Nicklas, Hannah and Martlbauer, Thomas and Hammer, Stephan and Riener, Andreas},
title = {Explainable Automation: Personalized and Adaptive UIs to Foster Trust and Understanding of Driving Automation Systems},
year = {2020},
isbn = {9781450380652},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
url = {https://doi.org/10.1145/3409120.3410659},
doi = {10.1145/3409120.3410659},
abstract = {Recent research indicates that transparent information on the behavior of automated vehicles positively affects trust, but how such feedback should be composed and if user trust influences the amount of desired feedback is relatively unexplored. Consequently, we conducted an interview study with (N=56) participants, who were presented different videos of an automated vehicle from the ego-perspective. Subjects rated their trust in the vehicle in these situations and could arbitrarily select objects in the driving environment that should be included in augmented reality feedback systems, so that they are able to trust the vehicle and understand its actions. The results show an inverse correlation between situational trust and participants’ desire for feedback and further reveal reasons why certain objects should be included in feedback systems. The study also highlights the need for more adaptive in-vehicle interfaces for trust calibration and outlines necessary steps for automatically generating feedback in the future.},
booktitle = {12th International Conference on Automotive User Interfaces and Interactive Vehicular Applications},
pages = {252–261},
numpages = {10},
keywords = {augmented reality, automated driving, explainable artificial intelligence, feedback systems, interview studies, trust in automation, user centered design},
location = {Virtual Event, DC, USA},
series = {AutomotiveUI '20}
}

