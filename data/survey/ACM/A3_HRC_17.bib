@inproceedings{10.1145/3027063.3053140,
author = {Zhou, Jianlong and Arshad, Syed Z. and Luo, Simon and Yu, Kun and Berkovsky, Shlomo and Chen, Fang},
title = {Indexing Cognitive Load using Blood Volume Pulse Features},
year = {2017},
isbn = {9781450346566},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
url = {https://doi.org/10.1145/3027063.3053140},
doi = {10.1145/3027063.3053140},
abstract = {Physiological responses contain rich affective information even when humans are not expressing any external signs. In this paper, we investigate the use of the Blood Volume Pulse (BVP) signals for indexing cognitive load. An experiment, which introduced cognitive load as a secondary task in a decision making context was conducted in the study. BVP signals were analyzed in order to establish relationships between BVP and cognitive load levels. A set of features (e.g. peak and max features) was found to be significantly distinctive across different cognitive load levels. The identified BVP features can be used to set up machine learning models for the automatic classification of CL levels in intelligent systems.},
booktitle = {Proceedings of the 2017 CHI Conference Extended Abstracts on Human Factors in Computing Systems},
pages = {2269–2275},
numpages = {7},
keywords = {bvp, cognitive load, peak and max features},
location = {Denver, Colorado, USA},
series = {CHI EA '17}
}

