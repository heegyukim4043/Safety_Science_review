@inproceedings{10.1145/3744169.3744179,
author = {Lin, Cindy Kaiying and Dombrowski, Lynn and Bardzell, Shaowen},
title = {Whose, Which, and What Crisis? A Critical Analysis of Crisis in Computing Supply Chains},
year = {2025},
isbn = {9798400720031},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
url = {https://doi.org/10.1145/3744169.3744179},
doi = {10.1145/3744169.3744179},
abstract = {This paper introduces a different way of thinking about crisis, identifying whose, which, and what crisis is at stake when dominant articulations of computing supply chains emphasize breakages, delays, and disruptions as reasons to further control supply chains. We call this formulation“against crisis thinking”. Against crisis thinking emphasizes how crisis in and along the computing supply chain is never a self-evident phenomenon. While HCI scholars have developed design and computing approaches to mitigate social, economic, and climate challenges in and along computing supply chains, the field has paid less attention to how the term crisis is first articulated in public discourse, how it is exploited by powerful actors to reinforce business as usual, and the uneven impacts of crisis thinking on marginalized communities. By providing such a formulation, we provide HCI multiple sites of intervention across a highly interconnected, complex, and transregional computing supply chain to generate progressive alternatives.},
booktitle = {Proceedings of the Sixth Decennial Aarhus Conference: Computing X Crisis},
pages = {56–70},
numpages = {15},
keywords = {crisis, supply chains, labor, semiconductor, environment, computing},
location = {
},
series = {AAR '25}
}

@article{10.1145/3816994,
author = {Ajmani, Leah and Zhou, Moyan and Andic, Tanja and Berson, Amber and Johnson, Isaac and Hill, Benjamin Mako and Maung, Rebecca and Narayan, Sneha and Severson, Sarah and Terveen, Loren and Chancellor, Stevie},
title = {Sanctioned by Others: Remediating Knowledge Exclusion on Wikipedia Through Design},
year = {2026},
issue_date = {October 2026},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
volume = {10},
number = {6},
url = {https://doi.org/10.1145/3816994},
doi = {10.1145/3816994},
abstract = {Knowledge-based institutions, such as libraries and archives, are ripe venues for knowledge gaps, defined as systemic disparities in content coverage or participation. The core problem is not that knowledge gaps exist, but that they often further disempower already marginalized communities. By reinforcing systemic inequity, knowledge gaps are matters of justice. In this paper, we draw on critical scholarship about knowledge exclusion and take a design lens to a pressing instantiation: knowledge gaps on Wikipedia. We present findings from a two-day Wikipedia expert workshop focused on how knowledge gaps manifest in editors’ interactions with platform policy. Our core contribution is an empirically grounded argument that a more inclusive Wikipedia is one in which editors can acquire the skills to invoke, bend, and even break the platform policies that dictate encyclopedic content. To make this argument, we synthesize author testimony into (1) a problem space articulating contributing factors and (2) a two-dimensional solution space where policy engagement can be at odds with policy adherence. To illustrate this inclusive Wikipedia future, we present speculative prototypes along the engagement-adherence matrix. Finally, we discuss the epistemic implications of our work, returning to formative philosophies on knowledge inclusion and justice.},
journal = {Proc. ACM Hum.-Comput. Interact.},
month = sep,
articleno = {CSCW146},
numpages = {35},
keywords = {Peer production, online communities, governance, epistemology}
}

