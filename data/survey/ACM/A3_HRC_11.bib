doi = {10.1145/3603555.3608527},
abstract = {This paper explores the concept of Cyber-Physical \&amp; Human Systems (CPHS), which consist of cyber-physical computer systems and humans that interact on different levels, physically and digitally. CPHS focuses on two aspects: the cyber-physical system and the human system, and how they are linked by artificial intelligence (AI). This concept applies in various applications, such as medical systems, assistance systems, and environmental systems. Aside from providing a comprehensive overview of CPHS and its related concepts, the paper ultimately contributes a definition and closes with an outlook.},
