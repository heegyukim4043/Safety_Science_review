@inproceedings{10.1145/3820253.3820279,
author = {S{\"o}hngen, Yannic Nicolai and Guerra, Enrico and Prilla, Michael},
title = {A Humanoid Robot Morphology Does Not Always Lead To A Higher Perception Of Anthropomorphism And Trust},
year = {2026},
isbn = {9798400726118},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
url = {https://doi.org/10.1145/3820253.3820279},
doi = {10.1145/3820253.3820279},
abstract = {Trust is an important aspect that influences the outcome of human-robot collaborations. Robots with a humanoid morphology might influence perceptions of trust. In this paper, we provide a comparison of two robots, one with a humanoid and one with a technical morphology, performing a collaborative task. In addition to investigating the influence of robot morphology on anthropomorphism and trust, we examined the use of verbal assurances in both robots. For this, we conducted a 2x3 study with 60 participants. Our analysis shows that the perception of anthropomorphism did have a positive and reliable effect on trust, while robot morphology and forecast did not impact trust reliably. We discuss the implications of these findings. In particular, we hypothesize that certain humanoid features may make others redundant, or that perception of anthropomorphism might depend on upholding what we may call an “anthropomorphic illusion”.},
booktitle = {Proceedings of Mensch Und Computer 2026},
pages = {258–269},
numpages = {12},
keywords = {Human-robot interaction, Trust, Anthropomorphism, Morphology},
location = {
},
series = {MuC '26}
}

@inproceedings{10.1145/3607822.3614528,
author = {Yang, Xiliu and Sousa Calepso, Aim{\'e}e and Amtsberg, Felix and Menges, Achim and Sedlmair, Michael},
title = {Usability Evaluation of an Augmented Reality System for Collaborative Fabrication between Multiple Humans and Industrial Robots},
year = {2023},
isbn = {9798400702815},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
url = {https://doi.org/10.1145/3607822.3614528},
doi = {10.1145/3607822.3614528},
abstract = {Semi-automated timber fabrication tasks demand the expertise and dexterity of human workers in addition to the use of automated robotic systems. In this paper, we introduce a human-robot collaborative system based on Augmented Reality (AR). To assess our approach, we conducted an exploratory user study on a head-mounted display (HMD) interface for task sharing between humans and an industrial robotic platform (N=16). Instead of screen-based interfaces, HMDs allowed users to receive information in-situ, regardless of their location in the workspace and the need to use their hands to handle tools or carry out tasks. We analyzed the resulting open-ended, qualitative user feedback as well as the quantitative user experience data. From the results, we derived challenges to tackle in future implementations and questions that need to be investigated to improve AR-based HRI in fabrication scenarios. The results also suggest that some aspects of human-robot interaction, like communication and trust, are more prominent when implementing a non-dyadic scenario and dealing with larger robots. The study is intended as a prequel to future work into AR-based collaboration between multiple humans and industrial robots.},
booktitle = {Proceedings of the 2023 ACM Symposium on Spatial User Interaction},
articleno = {18},
numpages = {10},
keywords = {augmented reality, human-robot interaction, robotic fabrication, user experience},
location = {Sydney, NSW, Australia},
series = {SUI '23}
}

@inproceedings{3712729.3712863,
author = {Malik, Ali Ahmad},
title = {The Economic Impact of Digital Twin Technology on Manufacturing Systems},
year = {2025},
isbn = {9798331534202},
publisher = {IEEE Press},
abstract = {Digital Twin technology is rapidly advancing, offering a virtual representation that models and connects complex physical systems for diverse purposes like simulation, monitoring, maintenance, and optimization. In contrast to traditional approaches limited to simulating specific physical processes, simulations within a digital twin comprise polymorphic environments that accurately depict large-scale systems. These digital twins remain connected to their physical counterparts through real-time data and feedback loops. While the benefits of implementing digital twins are numerous, the resources, effort, and investment required can vary for each use case. Manufacturers often must assess the return on investment (ROI) before committing to these initiatives. However, digital twins' intricate, multidimensional nature poses challenges in accurately evaluating their ROIs. This research assesses the economic impact of developing digital twins for manufacturing systems and presents a practical framework for assessing ROI. This systematic approach can help stakeholders enhance the financial viability of digital twin projects.},
booktitle = {Proceedings of the Winter Simulation Conference},
pages = {1623–1633},
numpages = {11},
location = {Orlando, Florida, USA},
series = {WSC '24}
}

