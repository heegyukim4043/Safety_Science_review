@article{10.1145/3457188,
author = {Wallk{\"o}tter, Sebastian and Tulli, Silvia and Castellano, Ginevra and Paiva, Ana and Chetouani, Mohamed},
title = {Explainable Embodied Agents Through Social Cues: A Review},
year = {2021},
issue_date = {September 2021},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
volume = {10},
number = {3},
url = {https://doi.org/10.1145/3457188},
doi = {10.1145/3457188},
abstract = {The issue of how to make embodied agents explainable has experienced a surge of interest over the past 3 years, and there are many terms that refer to this concept, such as transparency and legibility. One reason for this high variance in terminology is the unique array of social cues that embodied agents can access in contrast to that accessed by non-embodied agents. Another reason is that different authors use these terms in different ways. Hence, we review the existing literature on explainability and organize it by (1) providing an overview of existing definitions, (2) showing how explainability is implemented and how it exploits different social cues, and (3) showing how the impact of explainability is measured. Additionally, we present a list of open questions and challenges that highlight areas that require further investigation by the community. This provides the interested reader with an overview of the current state of the art.},
journal = {J. Hum.-Robot Interact.},
month = jul,
articleno = {27},
numpages = {24},
keywords = {Transparency, accountability, embodied social agents, explainability, explainable agency, expressive behavior, intelligibility, interpretability, legibility, predictability, robots}
}

@inproceedings{10.1145/3820709.3820710,
author = {Wang, Yuqi and Huang, Jiacai and Li, Hongsheng and Zhang, Jun and Geng, Ranran},
title = {On Application and Research Progress of Cable-Driven Technology in Rehabilitation Training Robots},
year = {2026},
isbn = {9798400722622},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
url = {https://doi.org/10.1145/3820709.3820710},
doi = {10.1145/3820709.3820710},
abstract = {The development of novel rehabilitation training robots is increasingly focused on enhancing training performance and achieving optimal outcomes. This places significant demands on the cable-driven support technology used in rehabilitation training. To enhance the effectiveness of such training, it is essential to explore new intelligent cable-driven support technologies that align with the latest advancements in rehabilitation. Cable-driven support is an innovative "soft" support structure based on robotics technology. It offers advantages such as excellent compliance, ample motion space, and high modularity, providing a fresh approach to rehabilitation training. This paper first comprehensively expounds on the application of cable-driven technology in rehabilitation training and conducts a dynamic analysis. Furthermore, considering the technical properties of cable drive systems and the diverse constraint conditions, cable-driven rehabilitation training robots are categorized into two types: redundantly constrained and under-constrained. The key technical issues and core research contents pertinent to these two types of robots are examined. Finally, the paper concludes by highlighting that future developments in cable-driven technology for rehabilitation training will focus on personalization and multimodal sensing. This focus is able to supply a solid theoretical foundation and technical support for the clinical application of cable-driven rehabilitation training robots.},
booktitle = {Proceedings of the 6th International Conference on Robotics and Control Engineering},
pages = {152–160},
numpages = {9},
keywords = {Rehabilitation training robot, cable-driven technology, human-machine interaction, multimodal sensing, personalization},
location = {
},
series = {RobCE '26}
}

