@article{10.1145/3834773,
author = {Centeio Jorge, Carolina and Jonker, Catholijn M. and Robert, Lionel P. and de Visser, Ewart J. and Tielman, Myrthe L.},
title = {“I Know You’re Capable, but Are You Willing?”: Allocating Tasks in Human–Machine Teams},
year = {2026},
issue_date = {September 2026},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
volume = {15},
number = {5},
url = {https://doi.org/10.1145/3834773},
doi = {10.1145/3834773},
abstract = {In human–machine teams, task allocation algorithms typically prioritize competence and other performance-related factors, overlooking human willingness to perform specific tasks. A recent framework proposed incorporating both competence and willingness into task allocation, but its effects on teamwork outcomes remain untested. This article investigates the impact of willingness-based task allocation in a simulated search and rescue (SAR) setting. We conducted a 2 {\texttimes} 2 user study (N = 72) in a 2D grid-world SAR scenario, where human participants collaborated with two virtual robots, which either used a willingness-based or a balanced task allocation strategy. Half the participants were able to change the task allocation prior to the start of the mission. Participants preferred robots and plans that accounted for their preferences, yet willingness-based allocation did not significantly influence trust in the robot or perceived team fluency, as these remained high throughout. Moreover, allowing changes to task allocation improved human performance. Our findings also suggest that the benefits of incorporating willingness may be context-dependent, with greater potential in lower-stakes tasks and longer-term teams.},
journal = {J. Hum.-Robot Interact.},
month = sep,
articleno = {94},
numpages = {22},
keywords = {Willingness, Beliefs, Artificial Trust, Human–Robot Teamwork, Task allocation}
}

@inproceedings{10.1145/2927929.2927948,
author = {Matsas, Elias and Vosniakos, George-C. and Batras, Dimitrios},
title = {Modelling simple human-robot collaborative manufacturing tasks in interactive virtual environments},
year = {2016},
isbn = {9781450341806},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
url = {https://doi.org/10.1145/2927929.2927948},
doi = {10.1145/2927929.2927948},
abstract = {This paper presents in brief a novel interactive Virtual Environment (VE) that simulates in real-time collaborative manufacturing tasks between a human and an industrial robotic manipulator, working in close proximity, while sharing their workspaces. The use case scenario is highly collaborative and incorporates a wide variety of interaction tasks, such as: collaborative handling, manipulation, removal, placement and laying of carbon fabric composite parts. A Kinect sensor and a Head Mounted Display (Oculus Rift) are employed as 3D User Interfaces for interaction, immersion and skeletal tracking of the user motion. In this paper, particular emphasis is given to the various interaction techniques used to facilitate implementation of virtual Human-Robot Collaboration (HRC). The collaborative tasks are principally executed with contactless, natural and direct interaction. In addition, two novel interaction metaphors were developed. The real fabric laying task and the backing film removal task are reproduced in the VE with the implementation of the "follow-my-hand" technique; the user has to follow with his hand a virtual hand-like index (guide) that moves along a predefined pattern. Preliminary findings concerning the effectiveness of HRC modelling tasks are positive, and are briefly discussed.},
booktitle = {Proceedings of the 2016 Virtual Reality International Conference},
articleno = {20},
numpages = {4},
keywords = {human-robot collaboration, human-robot cooperation, interaction techniques, virtual environments, virtual manufacturing, virtual reality},
location = {Laval, France},
series = {VRIC '16}
}

@article{10.1145/3786760,
author = {Pons, Patricia and Soler-Dominguez, Jose Luis and Navas-Medrano, Samuel},
title = {Designing Gesture-Based Interfaces for Cobots: Insights from a Mixed Reality Elicitation Study},
year = {2026},
issue_date = {May 2026},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
volume = {15},
number = {3},
url = {https://doi.org/10.1145/3786760},
doi = {10.1145/3786760},
abstract = {The rapid evolution of human–robot interaction, particularly within human–robot collaboration, presents a transformative opportunity through mixed reality (MR) technologies to redefine industrial automation and safety. This article addresses the increasing demand for intuitive human–robot interfaces in emerging paradigms like Industry 5.0 and the Industrial Metaverse. Our motivation is to bridge the gap in understanding how users naturally interact with collaborative robots when immersed in MR environments. We present a novel elicitation study utilizing a Microsoft Hololens 2 head-mounted display (HMD), where users perceived their gestures directly controlling a cobot through real-time visual feedback within the MR space. This methodology allowed us to derive a set of natural, intuitive gesture-based control mechanisms tailored for MR-enhanced industrial robotics. The novelty lies in providing empirically grounded insights into user-defined gestural language under MR constraints for cobot navigation tasks and exploring the influence of user characteristics on these gestures. Our findings demonstrate MR’s potential to foster a more integrated, productive, and safe workspace by enhancing operational efficiency, reducing operator learning curves, and improving safety protocols in high-risk settings. We also identify key differences in gesture selection based on gender (in the gesture’s “Nature”) and professional background (in the gesture’s “Locale”), providing design implications for user-adaptive interfaces. These findings advance the applicability of MR technology in complex industrial environments, proposing new paradigms for human–robot interaction.},
journal = {J. Hum.-Robot Interact.},
month = feb,
articleno = {54},
numpages = {31},
keywords = {Gestural language, gestural interface, elicitation study, mixed reality, cobots}
}

@inproceedings{10.1145/3811427.3811522,
author = {Nowarra, Pascal and Mensing, Lukas and Huemer, Barbara and Rathberger, Jonas and Z{\"u}hlke, Samuel and Riegler, Andreas and Probst, Kathrin},
title = {MoCoRo: Towards A Modular Robotics Platform for Automated Cocktail Creation},
year = {2026},
isbn = {9798400723421},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
url = {https://doi.org/10.1145/3811427.3811522},
doi = {10.1145/3811427.3811522},
abstract = {Reimagining the intersection of social hospitality and automated systems, we introduce MoCoRo, a Modular Cocktail Robotics Platform designed as a research testbed for reconfigurable, human-centered human–robot interaction. The system consists of connectable robotic modules coordinated by a transport system and complemented by a multimodal ordering terminal that enables fluid human–robot collaboration. To address scalability limitations caused by serial processing, we outline a roadmap using high-fidelity digital twins and decentralized scheduling, enabling adaptive, parallelized robotic ecosystems suitable for dynamic public environments.},
booktitle = {Proceedings of the 2026 International Conference on Advanced Visual Interfaces},
articleno = {68},
numpages = {3},
keywords = {cocktail robotics, modular interfaces, tangible interfaces},
location = {
},
series = {AVI '26}
}

@inproceedings{10.1145/3774521.3774603,
author = {Mittal, Raghav and Tiwari, Lokender and Shukla, Shivam Ashok and Halder, Mritunjoy and Bhowmick, Brojeshwar},
title = {GeMR : Multi-modal Interactive 3D Scene Composition In XR},
year = {2026},
isbn = {9798400719301},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
url = {https://doi.org/10.1145/3774521.3774603},
doi = {10.1145/3774521.3774603},
abstract = {This paper introduces a novel mixed-reality (MR) 3D authoring platform designed to enable real-time, interactive composition of 3D scenes in augmented and mixed reality environments. The platform proposed and integrates two key innovations: a three-tier 3D asset generation workflow and a 3D sketch-to-shape retrieval algorithm. The three-tier architecture addresses the challenge of time-consuming 3D asset creation by allowing users to engage with the generation process at intermediate stages, enabling rapid validation and refinement of user inputs. This approach not only enhances interactivity but also accelerates the realization of user imagined assets. Complementing this is our 3D sketch-to-shape retrieval system, which leverages an intuitive, robust sketching module to query a library of generated or artist-created 3D assets. This mechanism facilitates precise retrieval of objects matching both the category and rough shape of a user drawn 3D sketch of the assets. The platform supports multi-modal, intuitive user inputs such as speech, text, and freehand 3D sketches, making it accessible to both novice and expert users for creating, retrieving, modifying, and composing 3D assets and textures. By combining generative models with intuitive interaction, the platform serves as a flexible testbed for 3D asset development and a tool to democratize 3D scene authoring. We show effectiveness of GeMR on various use-cases, including scenario composition for human-robot collaboration. We conducted a user study to evaluate whether our system effectively democratizes the 3D scene composition. We compared the performance of 3D modeling experts and novice users on a standardized scene creation task. Both novice and expert users reported equally good usability ratings and low perceived workload. Our findings highlight that an integration of generative models and multimodal intuitive inputs represents a significant leap in making the 3D scene authoring more accessible.},
booktitle = {Proceedings of the Sixteen Indian Conference on Computer Vision, Graphics and Image Processing},
articleno = {78},
numpages = {10},
keywords = {Mixed reality, Generative AI, Scene composition, AIGC},
location = {
},
series = {ICVGIP '25}
}

@inproceedings{3721488.3721572,
author = {Jia, Lesong and Styler, Breelyn Kane and Du, Na},
title = {More Than Automation: User Insights into the Functionality and Interface of Wheelchair-Mounted Robotic Arms},
year = {2025},
publisher = {IEEE Press},
abstract = {While voice-controlled automated Wheelchair-mounted robotic arms (WMRAs) could potentially offer more natural and simplified interactions than manual control, they introduce new challenges related to human-robot collaboration. To explore user expectations in terms of functionality and interface, we conducted semi-structured interviews with 13 powered wheelchair users who have upper limb impairments. A prototype with a robotic arm, a camera, and a Unity-based simulated interface was developed to help users understand the concept and functionality of the voice-controlled automated WMRA system during interviews. With safety as a priority, we found that users prioritized the WMRA's ability to grasp objects in challenging positions, such as on the ground or at high locations, and emphasized the need for a versatile gripper. Users also expected the WMRA to assist in performing complex daily tasks, with varying expectations for its performance based on task difficulty. Regarding the interface, users sought more information about the system's awareness and task execution, while emphasizing the importance of avoiding information overload. The demand for detailed safety information, such as temperature and gripping force, pointed to the need for enhanced sensor capabilities in the WMRA system. Additionally, concerns about privacy underscored the need for clear communication on privacy policies. Our results provide user-centered insights for automated WMRA, offering design implications and future research directions in areas such as user modeling, hardware, algorithms, and interface development.},
booktitle = {Proceedings of the 2025 ACM/IEEE International Conference on Human-Robot Interaction},
pages = {677–685},
numpages = {9},
keywords = {human-robot interaction, natural voice interaction, upper limb impairments, wheelchair-mounted robotic arm},
location = {Melbourne, Australia},
series = {HRI '25}
}

@inproceedings{10.1145/3197768.3203171,
author = {Abujelala, Maher and Gupta, Sanika and Makedon, Fillia},
title = {A Collaborative Assembly Task to Assess Worker Skills in Robot Manufacturing Environments},
year = {2018},
isbn = {9781450363907},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
url = {https://doi.org/10.1145/3197768.3203171},
doi = {10.1145/3197768.3203171},
abstract = {In recent years robots have been replacing human workers in many industries. As robot manufacturing becomes more optimized and cost effective, the use of robots is going to evolve in various fields. Thus, it is essential to prepare workers to operate robots and work collaboratively with them side by side. In this paper, we are proposing a human-robot collaborative task to assess human performance in experimental, industrial setup. The task is designed in both virtual and physical environments.},
booktitle = {Proceedings of the 11th PErvasive Technologies Related to Assistive Environments Conference},
pages = {118–119},
numpages = {2},
keywords = {Assembly Jobs, Human-Robot Collaboration, Virtual Reality, Vocational Training},
location = {Corfu, Greece},
series = {PETRA '18}
}

@inproceedings{10.1145/3191477.3191507,
author = {Saenz, Jos{\'e} and Elkmann, Norbert and Gibaru, Olivier and Neto, Pedro},
title = {Survey of methods for design of collaborative robotics applications- Why safety is a barrier to more widespread robotics uptake},
year = {2018},
isbn = {9781450363655},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
url = {https://doi.org/10.1145/3191477.3191507},
doi = {10.1145/3191477.3191507},
abstract = {While collaborative robots have made headlines through recent industrial applications, they are not as widespread in industry as it may seem. The authors of this paper believe that one reason for this slow uptake is due to the high requirements on the safety and the lack of engineering tools for analyzing collaborative robotics applications. Systems engineering provides a good framework for creating the engineering tools needed for faster and more reliable deployment, but has only recently been applied to robotics challenges. In this paper, we discuss the state of the art for designing robotics applications featuring human-robot collaboration (HRC) and then review existing systems engineering approaches, which could offer support. Our review aims to support the robotics community in the future development of engineering tools to better understand, plan, and implement applications featuring collaborative robotics.},
booktitle = {Proceedings of the 2018 4th International Conference on Mechatronics and Robotics Engineering},
pages = {95–101},
numpages = {7},
keywords = {Survey, collaborative robot application design, human-robot safety, model-driven systems engineering},
location = {Valenciennes, France},
series = {ICMRE 2018}
}

@inproceedings{10.1145/3788149.3788172,
author = {Mahmud, Saifuddin and Shaon, Hasan Shamim and Abdelfattah, Sherif and Kim, Jong-Hoon},
title = {A Cognitive Load-Oriented Debriefing and Mission Replay System for Robot-Assisted Disaster Response},
year = {2026},
isbn = {9798400719622},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
url = {https://doi.org/10.1145/3788149.3788172},
doi = {10.1145/3788149.3788172},
abstract = {In robot-assisted disaster response, cognitive overload remains a critical barrier to effective human–robot collaboration, both during missions and in post-mission learning. While real-time load reduction has been widely studied, the equally vital aspect of post-mission cognitive load management through systematic debriefing has received less attention. This paper presents DebriefLinker, a modular debriefing and mission replay system originally developed as part of a broader Cognitive Load Optimization framework for disaster response operations. The system captures, organizes, and replays mission logs, operator actions, and robot states, providing rescuers and trainers with an intuitive interface for after-action review. By aligning with Cognitive Load Theory, DebriefLinker aims to reduce extraneous cognitive load during review sessions and enhance germane load to reinforce effective decision-making patterns. The architecture integrates seamlessly with a Broker System and Mission Control unit, enabling synchronized playback of multimodal mission data, including sensor streams and operator input logs. This paper describes the system design, theoretical underpinnings, and demonstrates how replay tools can enhance skill transfer and training retention for complex SAR operations. Future work will explore integrating adaptive replay visualizations and objective workload metrics to further optimize learning outcomes.},
booktitle = {Proceedings of the 2025 9th International Conference on Computer Science and Artificial Intelligence},
pages = {708–714},
numpages = {7},
keywords = {Cognitive Load Theory, Disaster Response, Human–Robot Interaction, Mission Replay, After-Action Review, Robot-Assisted Search and Rescue, Debriefing System, Multi-Robot Systems},
location = {
},
series = {CSAI '25}
}

