@article{10.1145/3816984,
author = {Wang, Ziyi and Xiao, Sheng and Bie, Jiajun and Zou, Xiaowei and Yao, Teshu and Huang, Zimo},
title = {Platform Power and Worker Agency: A Socio-Technical Review of the Gig Economy},
year = {2026},
issue_date = {October 2026},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
volume = {10},
number = {6},
url = {https://doi.org/10.1145/3816984},
doi = {10.1145/3816984},
abstract = {The platform-mediated gig economy constitutes 4.4\% to 12.5\% of the global workforce. Understanding how platform design shapes working conditions, and how workers develop strategies to navigate platform constraints, is crucial to addressing challenges in this rapidly evolving sector. Following PRISMA guidelines, we examine 171 gig economy-related publications from 2019 to Nov. 2025, spanning algorithmic management systems, labor process theory, and workers’ insights. Employing a “best-fit” framework, we draw on Socio-technical Systems Theory and synthesize four strands of scholarship to consolidate findings from prior research. In doing so, we identify 46 technical mechanisms and five stakeholder relationships that have attracted particular attention in the existing literature. We further examine perception gaps among stakeholders and propose ethnographic research within platform firms as a promising avenue for uncovering the mechanisms through which these gaps are produced and sustained. We also argue that platforms’ informational advantage over workers, especially with their capacity to dynamically reconfigure rules in real time, constitutes a distinctive form of platform power that calls for scholarly attention.},
journal = {Proc. ACM Hum.-Comput. Interact.},
month = sep,
articleno = {CSCW136},
numpages = {39},
keywords = {Gig Economy, Platform Labor, Algorithmic Management, Socio-Technical Systems, Platform Governance, Data Inequality, Literature Review, Perception Gaps, Technology Mechanisms}
}

